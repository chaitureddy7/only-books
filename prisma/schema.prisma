generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
}

enum Intent {
  DATING
  BOOK_BUDDY
}

enum ExclusiveShelf {
  READ
  CURRENTLY_READING
  TO_READ
  OTHER
}

enum InterestStatus {
  PENDING
  MATCHED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  emailVerified      DateTime?
  name               String?
  image              String?
  gender             Gender?
  dob                DateTime?
  intent             Intent?
  preferredGenders   Gender[]
  city               String?
  pincode            String?
  consentGivenAt     DateTime?
  profileCompletedAt DateTime?
  csvUploadedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  userBooks         UserBook[]
  matchScoresAsA    MatchScore[] @relation("MatchUserA")
  matchScoresAsB    MatchScore[] @relation("MatchUserB")
  interestsSent     Interest[]   @relation("InterestFrom")
  interestsReceived Interest[]   @relation("InterestTo")

  accounts Account[]
  sessions Session[]

  @@index([city, gender])
  @@index([city, intent])
}

model Book {
  id            String  @id @default(cuid())
  isbn          String? @unique
  normalizedKey String? @unique
  title         String
  author        String
  avgRating     Float?
  numPages      Int?
  yearPublished Int?

  userBooks UserBook[]
}

model UserBook {
  id             String         @id @default(cuid())
  userId         String
  bookId         String
  myRating       Int?
  dateRead       DateTime?
  dateAdded      DateTime?
  exclusiveShelf ExclusiveShelf
  bookshelves    String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([userId, exclusiveShelf])
}

model MatchScore {
  id          String   @id @default(cuid())
  userAId     String
  userBId     String
  score       Float
  breakdown   Json
  algoVersion Int      @default(1)
  computedAt  DateTime @default(now())

  userA User @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId, algoVersion])
  @@index([userAId, score])
  @@index([userBId, score])
}

model Interest {
  id        String         @id @default(cuid())
  fromId    String
  toId      String
  status    InterestStatus @default(PENDING)
  createdAt DateTime       @default(now())
  matchedAt DateTime?

  from User @relation("InterestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("InterestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model CityUnlockStatus {
  id         String    @id @default(cuid())
  city       String
  gender     Gender
  count      Int       @default(0)
  threshold  Int
  unlockedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([city, gender])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
